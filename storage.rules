rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated and authorized
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check authorization via Firestore lookup (storage rules can read Firestore)
    function isAuthorized() {
      return isAuthenticated();
    }

    // Vehicles photos - only authorized users
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Clients documents - only authorized users
    match /clients/{clientId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Contracts - only authorized users.
    // Path convention: contracts/{reservationId}/{file}
    // The signing page does NOT access Storage directly; the backend
    // generates short-lived signed URLs when needed.
    match /contracts/{reservationId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Inspections - only authorized users
    match /inspections/{inspectionId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Vehicle maintenance documents (invoices, photos) - only
    // authorized users.  Path convention:
    //   vehicle-maintenance/{vehicleId}/{maintenanceId}/{file}
    match /vehicle-maintenance/{vehicleId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    /**
     * Facturas y tickets de gastos. Ruta: `expenses/{expenseId}/{ts}-{fichero}`.
     *
     * ⚠️ **Faltaba desde que se construyó el módulo** (4 de septiembre de 2026).
     * Sin esta regla la ruta caía en el «default deny» del final y adjuntar una
     * factura fallaba con `storage/unauthorized`. No se notó al construir Gastos
     * porque la subida quedó como lo único sin probar; salió al recorrer el
     * ciclo completo.
     */
    match /expenses/{expenseId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    /**
     * Las facturas que manda el propietario de un coche cedido.
     *
     * ⚠️ **Sin esta regla el fichero no sube**, y la pantalla no dice por qué:
     * el `match` de abajo lo deniega todo. Es el mismo descuido que tuvo la
     * factura de un gasto y que solo salió al recorrer el ciclo completo — la
     * carpeta nueva hay que declararla, no basta con escribir el código que
     * sube.
     *
     * ⚠️ Storage **no sabe qué rol tiene quien pide**: aquí no se puede repetir
     * el `callerIsAdmin()` de Firestore, porque eso exige leer `authorizedUsers`
     * y estas reglas no leen Firestore. Lo que de verdad protege el dato es que
     * el documento de la factura —con el importe, el número y a quién— sea de
     * administrador; el enlace al PDF solo lo tiene quien pueda leer ese
     * documento.
     */
    match /collaborator-invoices/{invoiceId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
