# Configuración de PRODUCCIÓN (rentalcar-veltomobility).
#
# Firebase carga automáticamente el fichero `.env.<projectId>` al desplegar y
# lo inyecta en el runtime. A diferencia de los secrets, esto NO hay que
# declararlo en las opciones de cada function: por eso los `VELTO_COMPANY_*`
# viven aquí y no en Secret Manager, donde estaban puestos y no llegaban.
#
# ⚠️ Aquí NO van credenciales. Nada que no puedas enseñar: este fichero está en
# el repositorio. Las claves (RESEND_API_KEY, REDSYS_SECRET_KEY) siguen en
# Secret Manager, declaradas con `defineSecret`.

# Correo de la empresa. Hace DOS cosas a la vez, y conviene saberlo:
#   1. es el remitente de los emails que envía Resend
#   2. es el correo impreso en el contrato y en los documentos
#
# ⚠️ Resend solo acepta remitentes de un dominio VERIFICADO en la cuenta. Si
# veltomobility.com no lo está, el envío del contrato falla con 403.
VELTO_COMPANY_EMAIL=reservas@veltomobility.com

# Dominio propio, el que ve el cliente. Gobierna DOS cosas:
#   1. el enlace de firma del contrato (`signingLink`)
#   2. los enlaces cortos /d/… de presupuestos y justificantes (`documentLink`)
#
# Sin esto, `documentLink` cae a https://rentalcar-veltomobility.web.app y el
# enlace de firma sale relativo, para que lo complete el frontend. Funcionan,
# pero el cliente recibe por WhatsApp una URL que no es la de la empresa.
#
# Sin barra final (el código la quita igual, pero así no hay dos formas).
VELTO_PUBLIC_BASE_URL=https://rentalcar.veltomobility.com

# --- Redsys ---------------------------------------------------------------
# Mismo comercio y mismo terminal que en desarrollo; lo que cambia es el
# entorno, y con él la pasarela contra la que se cobra.
#
# ⚠️ **`live` significa DINERO REAL.** Aquí no valen las tarjetas de prueba de
# Redsys: cada cobro que se lance contra este entorno se cobra de verdad y hay
# que devolverlo desde el panel del banco. Para ensayar, `velto-store`.
#
# La clave de firma de producción es la que esté en Secret Manager de ESTE
# proyecto: el banco da una distinta para test y para real, así que si aquí
# quedara la de pruebas, las firmas serían rechazadas (SIS0042).
REDSYS_MERCHANT_CODE=361040215
REDSYS_TERMINAL=1
REDSYS_ENVIRONMENT=live


# --- Datos bancarios de cobro -------------------------------------------
# Se imprimen en la factura cuando la forma de pago es transferencia. No son
# un secreto: van en cada factura que se le manda a un cliente.
VELTO_BANK_NAME=BBVA
VELTO_BANK_IBAN=ES48 0182 4888 1102 0195 5536


# --- Facturación ----------------------------------------------------------
# ⚠️ **Producción todavía NO emite facturas**, y por eso está en `false`: la
# primera factura emitida aquí es el punto de no retorno de `invoices`, que no se
# puede editar ni borrar.
#
# Mientras esté así, la pantalla no ofrece emitir la declaración responsable ni
# consulta el estado de la remisión — no es un fallo, es que aquí todavía no hay
# nada que declarar ni que remitir. Y `issueComplianceDeclaration` lo rechaza
# aunque alguien llegue por otro camino: una declaración emitida **no se puede
# borrar**, así que una emitida por error se queda para siempre.
#
# ⚠️ **Ponerlo en `true` es una decisión de Dorel**, y va junto con desplegar
# `issueInvoice` a producción. Lo otro que hay que decidir aparte es
# `VELTO_VERIFACTU_ENABLED` de abajo, que es el envío a la AEAT.
VELTO_INVOICING_ENABLED=false


# --- Regímenes intracomunitarios -----------------------------------------
# ⚠️ **`false` hasta que llegue el ROI, y esto es lo que lo impide de verdad.**
#
# La entrega intracomunitaria exenta (art. 25) y la inversión del sujeto pasivo
# exigen estar en el Registro de Operadores Intracomunitarios. VELTO no lo está.
# Facturar así sin ROI es dejar de repercutir un IVA que sí se debe, y una
# factura emitida no se edita ni se borra: se corrige con una rectificativa, y el
# cliente ya tiene la mala.
#
# ⚠️ **La AEAT no nos salva de esto.** Acepta el registro igual, porque su
# validación es de forma. Hasta hoy esto solo estaba documentado —«no se deben
# usar todavía»—, y una nota no la lee quien factura a las ocho de la tarde.
#
# ⚠️ **Ponerlo a `true` es una decisión de Dorel**, el día que el ROI esté
# concedido. No cuando esté solicitado: hasta la concesión no hay NIF-IVA válido
# en el VIES, y una exención sin NIF-IVA del comprador no se sostiene.
VELTO_EU_REGIMES_ENABLED=false


# --- VeriFactu ------------------------------------------------------------
# ⚠️ El registro de facturación se GUARDA desde la primera factura aunque no se
# envíe nada. No depende de estas variables: una factura emitida no se puede
# editar, y lo que no se guarde al emitirla no se podrá añadir en 2027.
#
# ⚠️ **`ENABLED` se pone a `true` el día que el envío a la AEAT funcione, no
# antes.** Enciende el QR y la leyenda «Factura verificable en la sede
# electrónica de la AEAT»; con el registro sin remitir, el cliente escanearía y
# la sede no tendría su factura.
#
# ⚠️ Y cuando se encienda, `ENV` tiene que ser `live`: con `test` el QR llevaría
# a preproducción, que no conoce las facturas reales.
VELTO_VERIFACTU_ENABLED=false
VELTO_VERIFACTU_ENV=live
