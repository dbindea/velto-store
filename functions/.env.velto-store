# Configuración de DESARROLLO (velto-store).
#
# Explícito a propósito, aunque coincida con el valor por defecto del código:
# desde que producción tiene su propio correo, saber cuál usa cada entorno no
# debería exigir leer `company-config.ts` y acordarse de qué se cae a qué.
#
# Mismas reglas que en el fichero de producción: aquí NO van credenciales.

# Dominio verificado en Resend desde el principio, y el que usan las pruebas.
VELTO_COMPANY_EMAIL=reservas@veltorent.com

# Dominio propio de desarrollo. Ver el fichero de producción para qué gobierna.
#
# ⚠️ Existe además un secret `VELTO_PUBLIC_BASE_URL` en Secret Manager, de antes.
# **No se usa**: `signingLink` y `documentLink` lo leen de `process.env` sin
# declararlo, así que nunca llegó al runtime. Manda este fichero. El secret
# puede borrarse cuando se confirme que nada más lo mira.
VELTO_PUBLIC_BASE_URL=https://store.veltorent.com
