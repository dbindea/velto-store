# Configuración de DESARROLLO (velto-store).
#
# Explícito a propósito, aunque coincida con el valor por defecto del código:
# desde que producción tiene su propio correo, saber cuál usa cada entorno no
# debería exigir leer `company-config.ts` y acordarse de qué se cae a qué.
#
# Mismas reglas que en el fichero de producción: aquí NO van credenciales.

# Dominio verificado en Resend desde el principio, y el que usan las pruebas.
VELTO_COMPANY_EMAIL=reservas@veltorent.com

# Dominio propio de desarrollo. Ver el fichero de producción para qué gobierna.
#
# ⚠️ Existe además un secret `VELTO_PUBLIC_BASE_URL` en Secret Manager, de antes.
# **No se usa**: `signingLink` y `documentLink` lo leen de `process.env` sin
# declararlo, así que nunca llegó al runtime. Manda este fichero. El secret
# puede borrarse cuando se confirme que nada más lo mira.
VELTO_PUBLIC_BASE_URL=https://store.veltorent.com

# --- Redsys ---------------------------------------------------------------
# El código de comercio y el terminal NO son secretos: viajan firmados dentro
# del formulario de pago que ve cualquier cliente en su navegador. Lo único
# secreto es la clave de firma, que sigue en Secret Manager como
# REDSYS_SECRET_KEY y sí está declarada en `secrets: [...]`.
#
# ⚠️ `test` no es un adorno: decide contra qué pasarela se paga.
#   test → https://sis-t.redsys.es:25443/sis/realizarPago  (tarjetas de prueba)
#   live → https://sis.redsys.es/sis/realizarPago          (dinero real)
# La URL no se configura: la elige el código a partir de este valor.
REDSYS_MERCHANT_CODE=361040215
REDSYS_TERMINAL=1
REDSYS_ENVIRONMENT=test


# --- Datos bancarios de cobro -------------------------------------------
# Se imprimen en la factura cuando la forma de pago es transferencia. No son
# un secreto: van en cada factura que se le manda a un cliente.
VELTO_BANK_NAME=BBVA
VELTO_BANK_IBAN=ES48 0182 4888 1102 0195 5536


# --- Facturación ----------------------------------------------------------
# ⚠️ **Si este entorno EMITE facturas.** No es lo mismo que la de VeriFactu de
# abajo: aquella dice si los registros se remiten a la AEAT, y esta si la
# aplicación factura aquí siquiera.
#
# Producción todavía no emite ninguna —la primera factura es el punto de no
# retorno de `invoices`—, y eso era un hecho que no estaba escrito en ningún
# sitio: la pantalla ofrecía «Emitir declaración» y el módulo de Facturas entero
# con las functions que los sirven sin desplegar, o sea botones que no hacen
# nada.
#
# ⚠️ **No se deduce de que falte la function.** Un callable ausente devuelve un
# error, y un error significa «algo va mal», no «esto aún no toca».
VELTO_INVOICING_ENABLED=true


# --- VeriFactu ------------------------------------------------------------
# ⚠️ El registro de facturación se GUARDA desde la primera factura, aunque no
# se envíe nada a la AEAT. Eso no depende de estas variables y no se apaga: una
# factura emitida no se puede editar, así que lo que no se guarde al emitirla
# no se podrá añadir en enero de 2027.
#
# Lo que estas dos gobiernan es lo que el CLIENTE ve:
#
# ⚠️ `ENABLED=true` enciende el QR de cotejo y la leyenda «Factura verificable
# en la sede electrónica de la AEAT». **No se enciende hasta que el envío
# funcione de verdad**: con la leyenda impresa y el registro sin remitir, el
# cliente escanea, la sede no encuentra su factura y lo que parece roto es la
# factura. Es el mismo error que el contrato que anunciaba una firma digital
# que no llevaba.
#
# ⚠️ **En DESARROLLO va activo desde el 9 de septiembre de 2026**, que es de lo
# que sirve tener dos entornos: aquí se remite de verdad, contra PREPRODUCCIÓN
# (`ENV=test` abajo), y el QR de una factura de desarrollo apunta al validador
# de pruebas. Nada de esto llega a la AEAT real. En producción sigue en `false`
# y solo lo cambia Dorel.
VELTO_VERIFACTU_ENABLED=true

# Contra qué validador apunta el QR. Igual que `REDSYS_ENVIRONMENT`:
#   test → https://prewww2.aeat.es/...           (preproducción)
#   live → https://www2.agenciatributaria.gob.es/... (real)
VELTO_VERIFACTU_ENV=test
