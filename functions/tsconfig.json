{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2020"
  },
  "compileOnSave": true,
  "include": ["src"],
  // Specs must never reach lib/ — firebase deploy ships whatever is there,
  // and the bundle would then import vitest at runtime.
  "exclude": ["src/**/*.spec.ts"]
}
