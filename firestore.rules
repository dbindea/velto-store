rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and authorized
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthorized(email) {
      return isAuthenticated() &&
        request.auth.token.email == email &&
        exists(/databases/$(database)/documents/authorizedUsers/$(email)) &&
        get(/databases/$(database)/documents/authorizedUsers/$(email)).data.active == true;
    }

    function isAdmin(email) {
      return isAuthenticated() &&
        request.auth.token.email == email &&
        exists(/databases/$(database)/documents/authorizedUsers/$(email)) &&
        get(/databases/$(database)/documents/authorizedUsers/$(email)).data.active == true &&
        get(/databases/$(database)/documents/authorizedUsers/$(email)).data.role == 'admin';
    }

    // El email del que pide, tal y como se guarda: en minúsculas.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Un administrador, sea cual sea el documento que esté mirando. `isAdmin`
    // compara el email del documento con el de quien pide, que sirve para
    // proteger el documento propio pero NO para listar la colección ni para
    // administrar a otro.
    function callerIsAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/authorizedUsers/$(callerEmail())) &&
        get(/databases/$(database)/documents/authorizedUsers/$(callerEmail())).data.active == true &&
        get(/databases/$(database)/documents/authorizedUsers/$(callerEmail())).data.role == 'admin';
    }

    // authorizedUsers: cada uno lee el suyo — que es lo que hace el login — y un
    // administrador los lee todos, que es lo que necesita la pantalla de
    // Ajustes.
    //
    // ⚠️ Hasta el 4 de septiembre de 2026 solo estaba la primera mitad, así que
    // listar la colección fallaba con permisos denegados por muy admin que fuera
    // quien lo pidiera: la regla comparaba el email del documento con el de
    // quien preguntaba, y en un `list` no hay un documento con el que comparar.
    match /authorizedUsers/{email} {
      allow get: if isAuthenticated() && request.auth.token.email == email;
      allow get, list: if callerIsAdmin();
      allow create, update, delete: if callerIsAdmin();
    }

    // settings: los lee cualquiera que haya entrado —el asistente de reservas
    // necesita la fianza y el IVA por defecto— y los escribe solo un
    // administrador. Las Cloud Functions entran con el admin SDK y se saltan
    // estas reglas, que es como leen la validez del presupuesto.
    match /settings/{document} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if callerIsAdmin();
    }

    // vehicles collection - only authorized users
    match /vehicles/{vehicleId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow create, update: if isAuthorized(request.auth.token.email);
      // Borrar es irreversible: solo administrador (N-11).
      allow delete: if callerIsAdmin();
    }

    // reservations collection - only authorized users
    match /reservations/{reservationId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow create: if isAuthorized(request.auth.token.email);
      // ⚠️ Un no-administrador puede actualizar una reserva —cobrar, entregar,
      // devolver— pero **no mover su precio**: `pricingSnapshot` tiene que
      // llegar igual que estaba. Es lo que impide cambiar a mano lo que ya se
      // pactó.
      //
      // Lo que esta regla NO cubre: el precio con el que la reserva **nace**.
      // Al crear no hay valor anterior con el que comparar, así que ahí manda
      // la comprobación del servicio. Ver N-11 en mejoras-pendientes.
      allow update: if isAuthorized(request.auth.token.email) && (
        callerIsAdmin() ||
        request.resource.data.pricingSnapshot == resource.data.pricingSnapshot
      );
      allow delete: if callerIsAdmin();
    }

    // clients collection - only authorized users
    match /clients/{clientId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow create, update: if isAuthorized(request.auth.token.email);
      // Borrar es irreversible: solo administrador (N-11).
      allow delete: if callerIsAdmin();
    }

    // payments: cualquier usuario autorizado, y **es deliberado**.
    //
    // ⚠️ No es el descuido que fue `invoices` el 8 de septiembre de 2026, donde
    // el permiso era de administrador y la regla no. Aquí no se puede cerrar:
    // la ficha de la reserva y la del cliente enseñan el resumen de sus cobros,
    // y para eso hay que leer los pagos **cobrados**. Una regla no distingue si
    // quien lee llegó desde una reserva o desde una consulta suelta a la
    // colección entera, así que cerrarla rompería la operación diaria.
    //
    // La consecuencia hay que decirla en voz alta: **un empleado puede listar
    // todos los cobros por la API REST y sumarlos**. Lo que la aplicación hace
    // es no ofrecerle el histórico (`viewPaymentHistory`, 11 de septiembre de
    // 2026), y eso es interfaz, no seguridad. Lo que sí impide reconstruir la
    // cuenta de resultados es que `expenses`, `invoices`, `collaboratorSales`,
    // `billingProfiles`, `invoiceCounters`, `verifactuDeclarations` y
    // `verifactuSubmissions` sean de administrador aquí abajo: sin gastos ni
    // comisiones no hay beneficio, solo ingresos.
    match /payments/{paymentId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow create, update: if isAuthorized(request.auth.token.email);
      // Borrar es irreversible: solo administrador (N-11).
      allow delete: if callerIsAdmin();
    }

    // expenses: la cuenta de gastos es información de dueño. Un empleado no
    // ve el módulo, así que tampoco la colección — si no, esconder el menú sería
    // decoración y bastaría con abrir la consola del navegador (N-11).
    match /expenses/{expenseId} {
      allow read, write: if callerIsAdmin();
    }

    // contracts collection - only authorized users
    match /contracts/{contractId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow create, update: if isAuthorized(request.auth.token.email);
      // Un contrato firmado no se borra desde la aplicación, ni siendo admin:
      // es el documento que acredita el alquiler.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // FACTURACIÓN
    // -----------------------------------------------------------------------
    // ⚠️ Una factura emitida NO se edita ni se borra. Nunca, ni siendo
    // administrador. Un error se corrige emitiendo una rectificativa, que es un
    // documento nuevo; y el número consumido queda consumido aunque la
    // operación se anule (art. 15 RD 1619/2012). Desde 2027 va además encadenada
    // por huella, así que borrar una rompería la cadena de todas las siguientes.
    //
    // ⚠️ `create` tampoco se permite desde el cliente, y esto es lo que las
    // reglas NO podrían proteger de otra forma: una regla puede impedir que se
    // toque una factura, pero no sabe cuál era el siguiente número correlativo,
    // así que no puede impedir que alguien escriba el que le dé la gana. El
    // número lo asigna `issueInvoice` con el admin SDK, dentro de una
    // transacción con su contador.
    //
    // Lo único que queda del lado del cliente es leerlas.
    // ⚠️ **Solo administrador para leer**, igual que `expenses`, y por el mismo
    // motivo: `permissions.util.ts` da `viewInvoices` únicamente al admin, y una
    // regla más laxa que el permiso de la aplicación no es una regla laxa — es
    // que el permiso no existe. Un empleado no vería el menú de Facturas, pero
    // desde cualquier cliente de Firestore tendría el nombre, el NIF, el
    // domicilio fiscal y el importe de todos los clientes que se hayan
    // facturado. Es exactamente el caso que documenta CLAUDE.md: los dos
    // ficheros se editan por separado y nada los ata.
    match /invoices/{invoiceId} {
      allow read: if callerIsAdmin();
      allow create, update, delete: if false;
    }

    // Los contadores de cada serie: `lastNumber` y `lastHash`. Solo el backend.
    // Tocarlos desde fuera abriría un hueco en la numeración o rompería el
    // encadenamiento, que son las dos cosas que no se pueden deshacer.
    match /invoiceCounters/{series} {
      allow read: if callerIsAdmin();
      allow write: if false;
    }

    // La declaración responsable del art. 15 de la Orden HAC/1177/2024, una por
    // cada versión del sistema.
    //
    // ⚠️ **Mismo trato que una factura: `create` desde la function y nada más.**
    // La declaración de una versión pasada sigue acreditando lo que se declaró
    // mientras esa versión estuvo emitiendo facturas, así que borrarla dejaría
    // sin amparo a todas las facturas de ese periodo. Y editarla convertiría un
    // documento de cumplimiento en algo que se puede ajustar después de los
    // hechos, que es justo lo contrario de lo que acredita.
    //
    // La lee un administrador: es quien responde de ella.
    match /verifactuDeclarations/{version} {
      allow read: if callerIsAdmin();
      allow create, update, delete: if false;
    }

    // El estado del envío de cada factura a la AEAT: pendiente, aceptado con su
    // CSV, o rechazado con el motivo.
    //
    // Se lee para poder enseñarlo —y para que un rechazo se vea, porque bloquea
    // la cadena entera—, pero **no se escribe desde el cliente por nada del
    // mundo**: marcar una factura como aceptada a mano diría que está presentada
    // ante la Agencia cuando no lo está, y eso es peor que no saberlo. Lo
    // escribe el backend con el acuse de la AEAT en la mano.
    //
    // Solo administrador, igual que `invoices`: cruzando el número de factura
    // con el CSV se reconstruye quién ha facturado qué, que es el mismo dato que
    // el permiso `viewInvoices` protege.
    match /verifactuSubmissions/{invoiceId} {
      allow read: if callerIsAdmin();
      allow create, update, delete: if false;
    }

    // Destinatarios de factura: quién paga, que no siempre es quien conduce.
    // Esto sí es una ficha normal y se edita como cualquier otra; lo que queda
    // congelado en la factura es el snapshot, no este documento.
    // Mismo criterio: un destinatario de factura lleva nombre, NIF y domicilio
    // fiscal —datos personales— y solo sirve para facturar, que es cosa de
    // administrador. Dejarlo abierto a cualquier autorizado daba acceso a la
    // agenda fiscal completa por la puerta de atrás.
    match /billingProfiles/{profileId} {
      allow read, write: if callerIsAdmin();
    }

    // Recordatorios manuales de la pantalla de Eventos: «comprar
    // ambientadores», «limpiar coches», «pagar incentivos».
    //
    // ⚠️ **Los ve y los escribe todo el equipo**, a diferencia de los
    // colaboradores. Decisión de Dorel del 10 de septiembre de 2026: es trabajo
    // que hace su gente, y esconderlo obligaría a decírselo por otra vía —con lo
    // que la pantalla no serviría de nada. Aquí no hay datos de dueño: lo que sí
    // los tiene son las comisiones, y esas están cerradas más abajo.
    match /reminders/{reminderId} {
      allow read, create, update: if isAuthorized(request.auth.token.email);
      // Borrar es irreversible: solo administrador, como en el resto.
      allow delete: if callerIsAdmin();
    }

    // -----------------------------------------------------------------------
    // COLABORADORES
    // -----------------------------------------------------------------------
    // Comerciales que traen clientes y cobran comisión. **No son usuarios**: no
    // entran nunca en la aplicación, son fichas como los clientes. Quien accede
    // vive en `authorizedUsers` y eso no cambia.
    //
    // ⚠️ **Solo administrador**, igual que `expenses` e `invoices`, y por el
    // mismo motivo: es lo que la empresa PAGA. Saber a quién y cuánto es
    // información de dueño, no de operación diaria. Si solo se escondiera el
    // menú, un empleado tendría la lista completa abriendo la consola del
    // navegador — es exactamente el agujero que tuvo `invoices` el 8 de
    // septiembre de 2026, cuando el permiso era de admin y la regla no.
    match /collaborators/{collaboratorId} {
      allow read, write: if callerIsAdmin();
    }

    // Las comisiones. Se pueden borrar —a diferencia de una factura, esto no
    // acredita nada ante nadie: es un registro interno— pero solo el admin.
    match /collaboratorSales/{saleId} {
      allow read, write: if callerIsAdmin();
    }

    // contractSigningTokens - NEVER read/write from the client.
    // Only Cloud Functions (admin SDK) can read or write tokens.
    // Public access is via the getContractForSigning / signContract
    // HTTPS callables that accept a token, never direct Firestore access.
    match /contractSigningTokens/{tokenId} {
      allow read, write: if false;
    }

    // redsysOrphanNotifications: avisos de Redsys que llegaron sin un pago al
    // que aplicarse. Los escribe el webhook con el admin SDK y son material de
    // diagnóstico —pueden contener un cobro real que la aplicación no registró—,
    // así que desde cliente no se tocan.
    match /redsysOrphanNotifications/{order} {
      allow read, write: if false;
    }

    // inspections collection - only authorized users
    match /inspections/{inspectionId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow create, update: if isAuthorized(request.auth.token.email);
      // Borrar es irreversible: solo administrador (N-11).
      allow delete: if callerIsAdmin();
    }

    // vehicleMaintenance collection - only authorized users.
    // Free-form maintenance records (oil change, ITV, insurance, etc.).
    match /vehicleMaintenance/{maintenanceId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow create, update: if isAuthorized(request.auth.token.email);
      // Borrar es irreversible: solo administrador (N-11).
      allow delete: if callerIsAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
