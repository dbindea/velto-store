rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and authorized
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthorized(email) {
      return isAuthenticated() &&
        request.auth.token.email == email &&
        exists(/databases/$(database)/documents/authorizedUsers/$(email)) &&
        get(/databases/$(database)/documents/authorizedUsers/$(email)).data.active == true;
    }

    function isAdmin(email) {
      return isAuthenticated() &&
        request.auth.token.email == email &&
        exists(/databases/$(database)/documents/authorizedUsers/$(email)) &&
        get(/databases/$(database)/documents/authorizedUsers/$(email)).data.active == true &&
        get(/databases/$(database)/documents/authorizedUsers/$(email)).data.role == 'admin';
    }

    // El email del que pide, tal y como se guarda: en minúsculas.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Un administrador, sea cual sea el documento que esté mirando. `isAdmin`
    // compara el email del documento con el de quien pide, que sirve para
    // proteger el documento propio pero NO para listar la colección ni para
    // administrar a otro.
    function callerIsAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/authorizedUsers/$(callerEmail())) &&
        get(/databases/$(database)/documents/authorizedUsers/$(callerEmail())).data.active == true &&
        get(/databases/$(database)/documents/authorizedUsers/$(callerEmail())).data.role == 'admin';
    }

    // authorizedUsers: cada uno lee el suyo — que es lo que hace el login — y un
    // administrador los lee todos, que es lo que necesita la pantalla de
    // Ajustes.
    //
    // ⚠️ Hasta el 4 de septiembre de 2026 solo estaba la primera mitad, así que
    // listar la colección fallaba con permisos denegados por muy admin que fuera
    // quien lo pidiera: la regla comparaba el email del documento con el de
    // quien preguntaba, y en un `list` no hay un documento con el que comparar.
    match /authorizedUsers/{email} {
      allow get: if isAuthenticated() && request.auth.token.email == email;
      allow get, list: if callerIsAdmin();
      allow create, update, delete: if callerIsAdmin();
    }

    // settings: los lee cualquiera que haya entrado —el asistente de reservas
    // necesita la fianza y el IVA por defecto— y los escribe solo un
    // administrador. Las Cloud Functions entran con el admin SDK y se saltan
    // estas reglas, que es como leen la validez del presupuesto.
    match /settings/{document} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if callerIsAdmin();
    }

    // vehicles collection - only authorized users
    match /vehicles/{vehicleId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // reservations collection - only authorized users
    match /reservations/{reservationId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // clients collection - only authorized users
    match /clients/{clientId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // payments collection - only authorized users
    match /payments/{paymentId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // expenses collection - only authorized users
    match /expenses/{expenseId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // contracts collection - only authorized users
    match /contracts/{contractId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // contractSigningTokens - NEVER read/write from the client.
    // Only Cloud Functions (admin SDK) can read or write tokens.
    // Public access is via the getContractForSigning / signContract
    // HTTPS callables that accept a token, never direct Firestore access.
    match /contractSigningTokens/{tokenId} {
      allow read, write: if false;
    }

    // inspections collection - only authorized users
    match /inspections/{inspectionId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // vehicleMaintenance collection - only authorized users.
    // Free-form maintenance records (oil change, ITV, insurance, etc.).
    match /vehicleMaintenance/{maintenanceId} {
      allow read: if isAuthorized(request.auth.token.email);
      allow write: if isAuthorized(request.auth.token.email);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
