---
import Base from '../layouts/Base.astro';
import PreReserva from '../components/PreReserva.astro';
---

{/*
  ⚠️ **Una sola página para todas las fichas, y el id se lee de la URL.**
  El sitio es estático: no hay `getStaticPaths` porque eso obligaría a conocer
  los coches en el build, y entonces publicar uno nuevo no se vería hasta el
  siguiente despliegue — justo lo que esta web evita.

  La URL bonita (`/coche/{id}`) la resuelve un **rewrite de Hosting** que manda
  todo `/coche/**` a este fichero. ⚠️ Si ese rewrite falta, la página devuelve
  404 y no hay ningún aviso: es el mismo fallo silencioso que tuvo `/d/**`, que
  acababa sirviendo la SPA y mandando al cliente a la pantalla de login.

  ⚠️ **Los estilos van en `is:global` y no es un descuido.** Toda la ficha la
  inyecta el script con `innerHTML`, así que esos nodos no llevan el atributo
  de encapsulación de Astro y una hoja normal **no los alcanzaría** — es el
  mismo fallo que dejó el botón de la tarjeta sin forma en la página de
  resultados. Astro empaqueta el CSS por página, así que esto solo viaja aquí.
*/}
<Base
  titulo="Vehículo | Velto"
  descripcion="Detalle del vehículo: plazas, cambio, combustible, kilómetros incluidos, disponibilidad real y precio por día."
  ruta={null}
  precarga="coche"
>
  <section class="seccion">
    <div class="contenedor">
      <p class="migas"><a href="/flota">← Volver a la flota</a></p>

      <div id="ficha" hidden></div>

      {/*
        La pre-reserva, el mismo componente que usa la página de resultados.
        Desde el 1 de octubre de 2026 el visitante cierra aquí: elegir fechas
        en el calendario y tener que volver al buscador para pedirlas era
        hacerle repetir una selección que ya había hecho.
      */}
      <PreReserva />
      <p id="cargando" class="aviso">Cargando el vehículo…</p>
      <p id="nohay" class="aviso" hidden>
        Este vehículo ya no está disponible en la web.
        <a href="/flota">Mira el resto de la flota</a>.
      </p>
      <p id="error" class="aviso aviso--error" hidden>
        No hemos podido cargar el vehículo. Vuelve a intentarlo o escríbenos.
      </p>
    </div>
  </section>
</Base>

<script>
  import {
    ficha,
    disponibilidadCoche,
    euros,
    nombreCoche,
    combustible,
    cambio,
    categoria,
    marcadoFoto,
    type CocheFicha,
    type FotoPublica,
  } from '../lib/api';
  import { SITIO } from '../lib/empresa';
  import { montarCalendario } from '../lib/calendario-vista';
  import { montarPreReserva, type DatosPreReserva } from '../lib/pre-reserva';
  import {
    comoCampo,
    diasDelRango,
    parseDiaIso,
    type Rango,
  } from '../lib/calendario-coche';
  import { instanteDeLaUrl } from '../lib/buscador';
  import { zonaPorNombre } from '../lib/zonas';

  const contenedor = document.getElementById('ficha')!;
  const cargando = document.getElementById('cargando')!;
  const nohay = document.getElementById('nohay')!;
  const error = document.getElementById('error')!;

  /** `/coche/ABC123` → `ABC123`. */
  const id = decodeURIComponent(location.pathname.split('/').filter(Boolean).pop() ?? '');

  /*
   * El diálogo se monta una vez, al cargar: su marcado está en la plantilla y
   * no depende del coche. Lo que cambia con cada selección es lo que se le
   * pasa al abrirlo.
   */
  const preReserva = montarPreReserva();

  const EXTRAS: Array<[keyof CocheFicha['features'], string]> = [
    ['airConditioning', 'Aire acondicionado'],
    ['navigation', 'Navegador'],
    ['parkingSensors', 'Sensores de aparcamiento'],
    ['rearCamera', 'Cámara trasera'],
    ['cruiseControl', 'Control de crucero'],
  ];

  const MESES = [
    'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
    'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
  ];

  /** «Del 1 al 4 de octubre», sin repetir el mes cuando es el mismo. */
  function rotuloRango(desde: Date, hasta: Date): string {
    const mismoMes = desde.getMonth() === hasta.getMonth() && desde.getFullYear() === hasta.getFullYear();
    const ini = mismoMes ? `${desde.getDate()}` : `${desde.getDate()} de ${MESES[desde.getMonth()]}`;
    return `Del ${ini} al ${hasta.getDate()} de ${MESES[hasta.getMonth()]}`;
  }

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
    );


  // ---- La galería -------------------------------------------------------

  /**
   * ⚠️ **Antes eran las fotos una debajo de otra, a todo el ancho de la
   * columna.** Con dos fotos la ficha medía dos pantallas de imágenes y la
   * segunda no la veía nadie; y como cada foto conserva su proporción, el
   * bloque cambiaba de alto según el coche. Lo dijo Dorel: «la galería hay que
   * revisarla porque se ve fatal».
   *
   * Ahora hay una principal con proporción fija y una tira de miniaturas
   * debajo, que es lo que espera cualquiera que haya mirado un coche en
   * internet.
   */
  function galeria(v: CocheFicha, nombre: string): string {
    if (!v.photos.length) {
      return `<div class="galeria"><div class="galeria__grande galeria__sinfoto">
        <span>Sin fotos todavía</span></div></div>`;
    }

    const principal = marcadoFoto(v.photos[0], {
      alt: nombre,
      // La galería ocupa ~1,3/2,1 del contenedor en escritorio.
      sizes: '(min-width: 900px) 700px, 94vw',
      eager: true,
    });

    /*
     * ⚠️ **Con una sola foto no hay miniaturas.** Una tira de una miniatura
     * que ya está arriba es un mando que no hace nada.
     */
    const tira =
      v.photos.length > 1
        ? `<div class="galeria__tira" role="group" aria-label="Fotos del vehículo">
            ${v.photos
              .map(
                (f, i) => `
              <button type="button" class="galeria__mini${i === 0 ? ' es-activa' : ''}"
                      data-foto="${i}" aria-pressed="${i === 0}"
                      aria-label="Ver la foto ${i + 1} de ${v.photos.length}">
                ${marcadoFoto(f, { alt: '', sizes: '96px' })}
              </button>`
              )
              .join('')}
          </div>`
        : '';

    return `<div class="galeria">
      <div class="galeria__grande" id="foto-grande">${principal}</div>
      ${tira}
    </div>`;
  }

  function conectarGaleria(v: CocheFicha, nombre: string): void {
    const grande = document.getElementById('foto-grande');
    const tira = contenedor.querySelector('.galeria__tira');
    if (!grande || !tira) return;

    tira.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest<HTMLElement>('[data-foto]');
      if (!boton) return;
      const i = Number(boton.dataset.foto);
      const foto: FotoPublica | undefined = v.photos[i];
      if (!foto) return;

      /*
       * ⚠️ La principal se repinta con `eager`: ya se está mirando, así que
       * dejarla en `lazy` la pediría igual pero con menos prioridad.
       */
      grande.innerHTML = marcadoFoto(foto, {
        alt: `${nombre} (${i + 1})`,
        sizes: '(min-width: 900px) 700px, 94vw',
        eager: true,
      });

      tira.querySelectorAll<HTMLElement>('[data-foto]').forEach((b) => {
        const activa = b === boton;
        b.classList.toggle('es-activa', activa);
        b.setAttribute('aria-pressed', String(activa));
      });
    });
  }

  // ---- La ficha ---------------------------------------------------------

  function pinta(v: CocheFicha): void {
    const nombre = nombreCoche(v);
    document.title = `${nombre} | Velto`;

    /*
     * ⚠️ **La canónica de la ficha se pone AQUÍ, no en el layout.** Esta página
     * se sirve desde un solo fichero —`/coche/**` reescribe a `/coche.html`—,
     * así que al compilar no existe «la ruta de esta página»: existen tantas
     * como coches. Pasándole `ruta` al layout, todas las fichas salían
     * declarando la misma URL, y hasta el 25 de septiembre de 2026 esa URL era
     * la **portada**: cada coche le decía a Google que es una copia de la
     * página principal.
     */
    const url = `${SITIO}/coche/${encodeURIComponent(v.id)}`;

    /*
     * ⚠️ Las dos se CREAN si no están, no se actualizan a secas. Desde que el
     * layout no emite ninguna para esta página, un
     * `querySelector(...)?.setAttribute(...)` no encuentra nada y **no hace
     * nada, sin error**: la ficha se quedó sin `og:url` —comprobado en el
     * navegador— y lo que se pierde es la tarjeta del enlace al compartir un
     * coche por WhatsApp, que es justo como se comparten.
     */
    const meta = (selector: string, crear: () => HTMLElement): HTMLElement => {
      let el = document.head.querySelector<HTMLElement>(selector);
      if (!el) {
        el = crear();
        document.head.appendChild(el);
      }
      return el;
    };

    meta('link[rel="canonical"]', () => {
      const l = document.createElement('link');
      l.rel = 'canonical';
      return l;
    }).setAttribute('href', url);

    meta('meta[property="og:url"]', () => {
      const m = document.createElement('meta');
      m.setAttribute('property', 'og:url');
      return m;
    }).setAttribute('content', url);

    const extras = EXTRAS.filter(([k]) => v.features[k]).map(([, txt]) => `<li>${txt}</li>`).join('');

    // ⚠️ Cada dato solo se pinta SI EXISTE. Una fila «Fianza: —» no informa de
    // nada y hace dudar de lo que sí está.
    const filas = [
      ['Categoría', categoria(v.category)],
      ['Plazas', String(v.seats)],
      ['Maletas', String(v.luggageCapacity)],
      ['Cambio', cambio(v.transmission)],
      ['Combustible', combustible(v.fuelType)],
      ['Año', String(v.year)],
      v.color ? ['Color', v.color] : null,
      v.includedKmPerDay ? ['Km incluidos por día', String(v.includedKmPerDay)] : null,
      v.depositAmount !== undefined ? ['Fianza', euros(v.depositAmount)] : null,
      v.minimumRentalDays && v.minimumRentalDays > 1
        ? ['Alquiler mínimo', `${v.minimumRentalDays} días`]
        : null,
    ].filter(Boolean) as Array<[string, string]>;

    /*
     * ⚠️ **Aquí vivían el botón de WhatsApp y la cabecera de precio de la
     * tarjeta de la derecha, y las dos se fueron el 2 de octubre de 2026.**
     * El botón lo quitó Dorel «para no distorsionar el flujo»: en una página
     * cuyo trabajo es que se elijan fechas, una salida a otro canal al lado
     * del botón de reservar compite con él —y el teléfono sigue en la
     * cabecera y el WhatsApp en el pie, que es donde se busca una salida—.
     * El «desde X €/día» se mudó a la tarjeta de acciones, que es la que
     * ahora enseña el precio: mientras no hay fechas dice el «desde», y en
     * cuanto las hay, el total.
     */

    /*
     * ⚠️ **Lo que incluye el alquiler, y SOLO lo que el sistema o el contrato
     * respaldan.** El kilometraje y la fianza salen del coche; el seguro
     * obligatorio y la asistencia, de la cláusula 13; el contrato digital, de
     * que `signContract` existe y sella con el certificado de la FNMT; y el
     * precio cerrado, de que la portada ya lo promete.
     *
     * ⚠️ **Lo que NO está, y Dorel lo pidió: «cobertura completa» y «sin
     * franquicia».** Las dos contradicen el papel que el cliente firma: la
     * cláusula 13 dice que el coche lleva la responsabilidad civil
     * **obligatoria** y que el todo riesgo «sólo será aplicable si ha sido
     * expresamente contratado y abonado por el ARRENDATARIO», y la fianza
     * existe precisamente porque responde de los daños. Anunciarlas aquí sería
     * decirle al cliente que si da un golpe está cubierto, y luego retenerle
     * la fianza con el contrato diciendo lo contrario. Es la misma frase que
     * ya se corrigió en la portada el 29 de septiembre («con todo riesgo
     * **opcional**») y en el pie el día 28.
     *
     * El día que Velto contrate de verdad una póliza a todo riesgo sin
     * franquicia, esto se escribe aquí y se cambia la cláusula 13 el mismo
     * día: el texto y el hecho se deciden juntos.
     */
    const incluye = [
      v.includedKmPerDay ? `${v.includedKmPerDay} km al día incluidos` : null,
      'Seguro obligatorio y asistencia en carretera',
      'Contrato digital: lo firmas desde el móvil',
      'Precio cerrado, sin gastos de gestión',
      'Entrega a domicilio gratis en Arganda y alrededores',
      v.depositAmount !== undefined ? `Fianza de ${euros(v.depositAmount)}, que se devuelve` : null,
    ].filter(Boolean) as string[];

    contenedor.innerHTML = `
      <p class="overline">${esc(categoria(v.category))}</p>
      <h1 class="ficha__titulo">${esc(nombre)}</h1>

      ${/*
         * ⚠️ **Tres piezas y no dos, para que en MÓVIL el orden sea otro.** En
         * escritorio la tarjeta de reserva va a la derecha y la ficha técnica
         * debajo de la galería; apilado, con la galería y el texto en un solo
         * bloque, la tarjeta caía **detrás de todo**: medido a 390 px, el
         * precio empezaba a 1.578 px y el botón de ver fechas más abajo
         * todavía. Separando la galería del resto, la rejilla las recoloca por
         * áreas en escritorio y el móvil se queda con el orden del código:
         * foto, precio y botones, y después la letra pequeña.
         */ ''}
      ${/*
         * ⚠️ **Cuatro cuadrantes, y el orden lo decidió Dorel el 2 de octubre
         * de 2026 mirando la página:** «en escritorio pondría arriba a la
         * izquierda la galería, a la derecha la ficha técnica, abajo a la
         * izquierda el calendario y a la derecha la card de acciones».
         *
         * ⚠️ **Y había DOS botones verdes.** Uno decía «Ver fechas libres» y
         * bajaba al calendario; el otro, «Reservar estas fechas», al lado del
         * calendario. Con las fechas ya puestas desde el buscador los dos
         * salían a la vez y ninguno era claramente el siguiente paso: «es muy
         * confuso, debería unir los dos botones en uno solo». Ahora la tarjeta
         * de acciones es **una**, está pegada al calendario y cambia sola con
         * lo que se marque.
         */ ''}
      <div class="ficha">
        <div class="ficha__galeria">
          ${galeria(v, nombre)}
          ${v.description ? `<p class="ficha__texto">${esc(v.description)}</p>` : ''}
        </div>

        ${/*
           * ⚠️ **La ficha técnica sigue PLEGADA aunque ahora esté arriba.** Es
           * secundaria —se mira después de decidir, no antes— y con los diez
           * datos desplegados la columna crecía más que la galería de al lado.
           * Es un `<details>` nativo: se abre sin JavaScript, con el teclado, y
           * el navegador lo encuentra al buscar dentro de la página.
           */ ''}
        <div class="ficha__resto">
          <div class="tecnica">
            <h2 class="tecnica__titulo">Ficha técnica</h2>
            <dl class="ficha__lista">
              ${filas
                .slice(0, 4)
                .map(([k, val]) => `<div><dt>${k}</dt><dd>${esc(val)}</dd></div>`)
                .join('')}
            </dl>
            ${
              filas.length > 4 || extras
                ? `<details class="tecnica__mas">
                    <summary>
                      <span class="tecnica__ver">Ver todas las características</span>
                      <span class="tecnica__ocultar">Ver menos</span>
                    </summary>
                    <dl class="ficha__lista">
                      ${filas
                        .slice(4)
                        .map(([k, val]) => `<div><dt>${k}</dt><dd>${esc(val)}</dd></div>`)
                        .join('')}
                    </dl>
                    ${
                      extras
                        ? `<p class="tecnica__rotulo">Equipamiento</p>
                           <ul class="ficha__extras">${extras}</ul>`
                        : ''
                    }
                  </details>`
                : ''
            }
          </div>
        </div>

        ${/*
             * ⚠️ **«Incluido en el alquiler» va AQUÍ y no al pie de la tarjeta
             * de acciones, y es por una medida.** Con los cuatro cuadrantes, la
             * ficha técnica plegada mide 315 px contra los 608 de la galería:
             * quedaban **290 px de hueco blanco** arriba a la derecha, visibles
             * en la primera pantalla de un escritorio. Esta lista los llena con
             * lo único que faltaba por decir del coche, y de paso deja la
             * tarjeta de abajo con lo suyo —fechas, precio y botón— en vez de
             * una lista de seis puntos entre el importe y el calendario.
             *
           * ⚠️ **Y es marcado fijo, no se repinta.** La tarjeta de acciones
           * se reescribe entera con cada selección; esto no depende de las
           * fechas, así que colgarlo de allí obligaba a volver a imprimirlo
           * en cada clic del calendario.
           *
           * ⚠️ **Es hermana de las otras cuatro, no va dentro de
           * `.ficha__resto`.** En escritorio da igual —ocupa su área—, pero en
           * móvil la rejilla es una columna y el orden lo decide el `order`:
           * metida dentro, estos 316 px quedaban **entre el coche y el
           * calendario** y empujaban el precio a 1.982 px del principio. Suelta
           * se puede mandar al final, que es donde una lista de tranquilidad
           * molesta menos.
           */ ''}
        <div class="incluye">
          <p class="incluye__rotulo">Incluido en el alquiler</p>
          <ul class="incluye__lista">
            ${incluye.map((t) => `<li>${esc(t)}</li>`).join('')}
          </ul>
        </div>

        ${/*
           * ⚠️ **El rótulo es un HERMANO del calendario, no su cabecera.** Lo
           * pidió Dorel el 2 de octubre de 2026: «la card del calendario debe
           * estar alineada en horizontal con la card de Reservar, y el texto
           * encima, más pegado a la galería». Metido dentro de la sección, sus
           * 90 px empujaban el calendario hacia abajo mientras la tarjeta de
           * la derecha arrancaba arriba del todo: dos tarjetas de la misma
           * fila que no empezaban a la misma altura. Suelto ocupa su propia
           * fila de la rejilla y las dos tarjetas quedan a ras.
           *
           * ⚠️ **Y ocupa SOLO la columna del calendario.** «Lo tachado ya está
           * cogido» describe el calendario; a lo ancho de las dos columnas
           * quedaría también sobre el precio, que no tiene nada tachado.
           */ ''}
        <header class="dispo__titulo">
          <h2 class="ficha__h2">Elige tus fechas</h2>
          <p class="dispo__entrada">
            Lo tachado ya está cogido. Marca el día de recogida y el de
            devolución.
          </p>
        </header>

        <section class="dispo" id="disponibilidad">
          <div class="cal" id="cal"></div>
        </section>

        ${/*
           * ⚠️ **UNA sola tarjeta de acciones, y cambia sola.** Sin fechas
           * enseña el «desde» y dice qué hacer; con fechas, los días, el total
           * y el botón de reservar. Antes eran dos tarjetas con un botón verde
           * cada una y el visitante tenía que adivinar cuál era el siguiente
           * paso.
           *
           * ⚠️ **El precio se recalcula solo al cambiar el calendario**, sin
           * ningún botón de por medio: lo pidió así Dorel, y además un botón
           * de «calcular» obliga a pulsarlo para enterarse de que una fecha ya
           * no vale.
           */ ''}
        <aside class="accion" id="accion"></aside>
      </div>

      ${/*
         * ⚠️ **Aquí NO va una lista de preguntas frecuentes.** Dorel lo dejó a
         * criterio —«valóralo tú»— y luego lo confirmó: «tienes razón que no
         * tienen sentido aquí». Las respuestas ya están en
         * `/preguntas-frecuentes`, y repetirlas sería una segunda copia de la
         * fianza, los kilómetros y la edad mínima.
         */ ''}
      <p class="ficha__pie">
        ¿Dudas con la fianza, los kilómetros o la edad mínima?
        <a href="/preguntas-frecuentes">Preguntas frecuentes</a> ·
        <a href="/condiciones">Condiciones de alquiler</a>
      </p>`;

    contenedor.hidden = false;
    conectarGaleria(v, nombre);
    conectarCalendario(v);
  }

  // ---- El calendario ----------------------------------------------------

  function conectarCalendario(v: CocheFicha): void {
    const caja = document.getElementById('cal');
    const encontrado = document.getElementById('accion');
    if (!caja || !encontrado) return;
    /*
     * Una constante ya estrechada: TypeScript no conserva el estrechamiento
     * dentro de las funciones de abajo, y ahí se usa media docena de veces.
     * Es el mismo apaño que lleva el combo de zonas.
     */
    const accion: HTMLElement = encontrado;

    const ocupados = new Set(v.busyDays ?? []);
    const horizonte = parseDiaIso(v.availableUntil);

    /** El número de la petición en curso: lo que descarta las respuestas viejas. */
    let peticion = 0;

    /** Lo último que se ha cotizado, que es lo que se manda al pedirlo. */
    let pedido: DatosPreReserva | null = null;

    /*
     * ⚠️ **Las fechas que traía el enlace, ya marcadas.** Quien llega desde
     * los resultados ya eligió sus días: pedírselos otra vez es hacerle
     * repetir lo que acaba de hacer. Se leen con el mismo lector que el
     * buscador (`instanteDeLaUrl`), que acepta también los enlaces antiguos
     * de solo fecha.
     */
    const params = new URLSearchParams(location.search);
    const desdeUrl = parseDiaIso((instanteDeLaUrl(params.get('from')) ?? '').slice(0, 10));
    const hastaUrl = parseDiaIso((instanteDeLaUrl(params.get('to')) ?? '').slice(0, 10));

    /*
     * ⚠️ **Y el LUGAR, que hasta el 2 de octubre de 2026 no llegaba hasta
     * aquí.** El buscador lo pide, la página de resultados lo lleva en su URL
     * y el salto a la ficha lo perdía: el visitante que había elegido
     * «Aeropuerto» mandaba una pre-reserva que no lo mencionaba, y a Velto le
     * llegaba igual que una de oficina — el caso que cuesta 30 € y una
     * furgoneta.
     *
     * ⚠️ **Se recorta al mismo tope que el backend** (80), por lo de siempre
     * con lo que llega por la barra de direcciones: aquí no hay más validación
     * que la del servidor, y lo que se pinta sale de `textContent`, nunca de
     * `innerHTML`.
     */
    const lugar = (params.get('place') ?? '').trim().slice(0, 80);
    const zona = lugar ? zonaPorNombre(lugar) : null;

    /**
     * El lugar de recogida, en la tarjeta del precio.
     *
     * ⚠️ **Se enseña, y su suplemento NO se suma.** El total de arriba es el
     * del **alquiler**: la entrega a domicilio es un servicio aparte que el
     * operador teclea por reserva (`deliveryFees`, fuera del
     * `pricingSnapshot`), y sumarla aquí sería inventarse una cifra que el
     * backoffice no va a poner sola. Lo que no puede pasar es callarla: quien
     * eligió «Aeropuerto · +30 €» tiene que ver que lo hemos entendido y que
     * eso va aparte del número grande.
     *
     * ⚠️ **El coste sale del catálogo, no del texto de la URL.** `lugar` llega
     * por la barra de direcciones y puede decir cualquier cosa; el importe
     * solo se imprime si el nombre casa con una zona de verdad. Para lo que no
     * está en el catálogo —un pueblo escrito a mano— no se promete ningún
     * precio, que es justo lo que `zonaPorNombre()` devuelve con `null`.
     */
    const lineaLugar = lugar
      ? `<p class="accion__lugar">Recogida en <strong>${esc(lugar)}</strong>${
          zona && zona.coste !== 'gratuito'
            ? ` · entrega ${esc(zona.coste)}, aparte`
            : zona
              ? ' · entrega gratuita'
              : ' · el desplazamiento lo acordamos'
        }</p>`
      : '';

    montarCalendario({
      contenedor: caja,
      ocupados,
      horizonte,
      rangoInicial: desdeUrl && hastaUrl ? { desde: desdeUrl, hasta: hastaUrl } : null,
      alCambiar: (rango) => pintarAccion(rango),
    });

    /** El «desde X €/día», que es lo que se enseña mientras no haya fechas. */
    function cabeceraSinFechas(): string {
      if (!v.priceFrom) {
        return `<p class="accion__precio accion__precio--consultar">Consúltanos el precio</p>`;
      }
      return `
        <p class="accion__desde num"><span>desde</span> <strong>${euros(v.priceFrom.gross)}</strong> <span>/día</span></p>
        ${v.priceFrom.fromDays ? `<p class="accion__letra">en alquileres de ${v.priceFrom.fromDays} días o más</p>` : ''}`;
    }

    function pintarAccion(rango: Rango): void {
      if (!rango.desde || !rango.hasta) {
        /*
         * ⚠️ **Sin fechas NO hay botón, y eso es deliberado.** Un «Reservar»
         * que no puede reservar nada es un botón que no hace nada, que en
         * esta casa es un fallo; y uno apagado sin explicación deja al
         * visitante pulsando. Lo que hay es la instrucción.
         */
        accion.innerHTML = `
          ${cabeceraSinFechas()}
          <p class="accion__pista">
            ${rango.desde
              ? 'Ahora marca el día de la devolución.'
              : 'Marca en el calendario el día de recogida y el de devolución y te decimos el precio final.'}
          </p>`;
        return;
      }

      const dias = diasDelRango(rango.desde, rango.hasta);
      const cabecera = `
        <p class="accion__fechas">${rotuloRango(rango.desde, rango.hasta)}</p>
        <p class="accion__dias">${dias === 1 ? '1 día' : `${dias} días`}</p>
        ${lineaLugar}`;

      accion.innerHTML = `${cabecera}<p class="accion__pista">Calculando el precio…</p>`;

      const desde = comoCampo(rango.desde);
      const hasta = comoCampo(rango.hasta);
      const mia = ++peticion;

      /*
       * ⚠️ **El precio lo da el backend, no la ficha.** El «desde» es el tramo
       * más barato —el de un alquiler largo— y la tabla de tramos no se
       * publica a propósito: es la curva de descuento del negocio. Calcular
       * aquí el precio de tres días sería inventárselo.
       */
      disponibilidadCoche(desde, hasta, v.id)
        .then((r) => {
          /*
           * ⚠️ **Se descartan las respuestas de una selección anterior.** Dos
           * clics seguidos lanzan dos peticiones y no tienen por qué volver en
           * orden: sin esto, el precio de las fechas viejas puede pintarse
           * encima del de las nuevas y quedarse ahí. Es dinero en pantalla.
           */
          if (mia !== peticion) return;

          const coche = r.vehicles[0];
          if (!coche) {
            /*
             * ⚠️ Puede pasar de verdad: entre que se pintó el calendario y se
             * eligieron las fechas, alguien ha reservado. Se dice, y se deja
             * el calendario tal cual para elegir otras — que es lo que se
             * hace para cambiarlas desde que no hay botón de quitar.
             */
            accion.innerHTML = `${cabecera}
              <p class="accion__aviso">Esas fechas acaban de ocuparse. Marca otras en el calendario.</p>`;
            return;
          }

          accion.innerHTML = `${cabecera}
            <p class="accion__precio num">${euros(coche.price.gross)}</p>
            <p class="accion__letra">Precio final del alquiler completo.</p>
            <button type="button" class="btn btn--brand accion__btn" id="pedir">
              Reservar estas fechas
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </button>`;

          pedido = {
            vehicleId: v.id,
            resumen:
              `${nombreCoche(v)} · ${dias === 1 ? '1 día' : `${dias} días`} · ${euros(coche.price.gross)}` +
              // El lugar entra en el resumen del diálogo: es lo último que el
              // visitante lee antes de dar su teléfono, y si lo hemos
              // entendido mal este es el momento de que lo vea.
              (lugar ? ` · ${lugar}` : ''),
            desde,
            hasta,
            ...(lugar ? { lugar } : {}),
            // Lo dice el backend con cada consulta: es un ajuste, no un número
            // escrito en la web.
            horasGarantia: r.priceGuaranteedHours,
          };
        })
        .catch(() => {
          if (mia !== peticion) return;
          accion.innerHTML = `${cabecera}
            <p class="accion__aviso">No hemos podido calcular el precio. Inténtalo otra vez.</p>`;
        });
    }

    /*
     * Delegado, porque el botón se repinta con cada selección: un oyente
     * puesto sobre el nodo de ahora se quedaría colgando del siguiente.
     */
    accion.addEventListener('click', (e) => {
      const boton = (e.target as HTMLElement).closest('#pedir');
      if (boton && pedido) preReserva?.abrir(pedido);
    });

    pintarAccion({ desde: null, hasta: null });
  }

  if (!id) {
    cargando.hidden = true;
    nohay.hidden = false;
  } else {
    ficha(id)
      .then(({ vehicle }) => {
        cargando.hidden = true;
        pinta(vehicle);
      })
      .catch((e: Error) => {
        cargando.hidden = true;
        // ⚠️ «No encontrado» y «algo ha fallado» son mensajes distintos: al
        // visitante le importa saber si el coche ya no está o si somos nosotros.
        if (e.message === 'not-found') nohay.hidden = false;
        else error.hidden = false;
      });
  }
</script>

<style is:global>
