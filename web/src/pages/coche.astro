---
import Base from '../layouts/Base.astro';
import FichaCoche from '../components/FichaCoche.astro';
---

{/*
  El **respaldo** de las fichas de coche.

  ⚠️ **Esta página existe para el coche que NO estaba cuando se compiló.** El
  rewrite `/coche/**` de `firebase.json` apunta aquí, y Firebase sirve un
  fichero estático antes que un rewrite: así `/coche/abc` usa
  `dist/coche/abc.html` si se generó en el build, y cae aquí si no.

  Es lo que conserva la regla de `astro.config.mjs` —**publicar un coche se ve
  al momento**— ahora que las fichas también se generan: un coche publicado
  esta mañana no tiene HTML propio hasta el siguiente despliegue, pero su
  página funciona desde el primer minuto porque la pinta el JavaScript.

  ⚠️ **Por eso su título y su descripción son GENÉRICOS, y tienen que serlo.**
  Aquí no se sabe qué coche se va a pintar —lo decide el id de la URL en el
  navegador—, así que lo único honesto es un texto que sea cierto de cualquier
  coche de la flota. El título bueno lo pone el script al cargar; quien ve el
  genérico es quien comparte el enlace de un coche recién publicado, y eso dura
  hasta el siguiente despliegue.
*/}
<Base
  titulo="Alquila este coche en Arganda del Rey | Velto"
  descripcion="Mira la disponibilidad real día a día, elige tus fechas y te damos el precio final del alquiler, con los impuestos incluidos y sin gastos de gestión."
  ruta={null}
  precarga="coche"
>
  <FichaCoche />
</Base>
