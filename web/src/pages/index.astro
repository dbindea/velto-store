---
import Base from '../layouts/Base.astro';
import { EMPRESA } from '../lib/empresa';

/**
 * ⚠️ **Las cuatro promesas salen del contrato y del backoffice, no del aire.**
 * La entrega a domicilio existe como concepto propio (`deliveryFees`, con sus
 * dos trayectos), el seguro va en el coche y se imprime en el contrato, y los
 * kilómetros se pactan por escrito. Si una de estas cuatro deja de ser cierta,
 * se quita de aquí — es la regla que ya mordió cinco veces en los PDF.
 */
const PROMESAS = [
  {
    titulo: 'Precio final desde el primer clic',
    texto:
      'Lo que ves es lo que pagas: IVA incluido y sin cargos que aparezcan al devolver el coche.',
  },
  {
    titulo: 'Te lo llevamos a casa',
    texto:
      'Entrega y recogida a domicilio en Arganda del Rey y alrededores. Se pacta antes y consta en el contrato.',
  },
  {
    titulo: 'Alguien responde',
    texto: `WhatsApp al ${EMPRESA.telefono}, también durante el alquiler. Contesta una persona.`,
  },
  {
    titulo: 'Kilómetros por escrito',
    texto:
      'Los kilómetros incluidos figuran en el contrato. Si no se pactó kilometraje, no se cobra.',
  },
];
---

<Base
  titulo="Velto — alquiler de coches con precio final en Arganda del Rey"
  descripcion="Alquiler de coches en Arganda del Rey con el precio final desde el primer clic: IVA incluido, kilómetros por escrito y entrega a domicilio."
>
  <!-- ---- Héroe ---------------------------------------------------------- -->
  <section class="hero">
    <div class="contenedor">
      <!-- Las tres barras del isotipo, inclinadas con `--skew`. -->
      <div class="barras" aria-hidden="true"><span></span><span></span><span></span></div>

      <h1 class="hero__titular">Alquila un coche con el precio final desde el primer clic.</h1>
      <p class="hero__entrada">
        Seguro incluido, kilómetros pactados por escrito y entrega a domicilio.
        Recoges en {EMPRESA.oficinaCalle} o te lo llevamos a casa.
      </p>
    </div>

    <!-- El buscador, montado sobre el corte entre el negro y el fondo. -->
    <div class="contenedor">
      <form class="buscador" action="/reservar" method="get">
        <div class="buscador__campo">
          <label for="desde">Recogida</label>
          <input type="date" id="desde" name="from" required />
        </div>
        <div class="buscador__campo">
          <label for="hasta">Devolución</label>
          <input type="date" id="hasta" name="to" required />
        </div>
        <button class="btn btn--brand buscador__btn" type="submit">
          Ver precios
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
        </button>
      </form>
    </div>
  </section>

  <!-- ---- Las cuatro promesas ------------------------------------------- -->
  <section class="seccion promesas-seccion">
    <div class="contenedor">
      <div class="rejilla">
        {
          PROMESAS.map((p) => (
            <article class="card promesa">
              <h2 class="promesa__titulo">{p.titulo}</h2>
              <p class="promesa__texto">{p.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---- Flota (se carga de la API) ------------------------------------- -->
  <section class="seccion seccion--alt">
    <div class="contenedor">
      <p class="overline">Flota</p>
      <div class="titulo-fila">
        <h2>Precio por día, todo incluido</h2>
        <a class="btn btn--ghost" href="/flota">Ver toda la flota</a>
      </div>

      <div id="lista" class="rejilla" hidden></div>
      <p id="cargando" class="aviso">Cargando la flota…</p>
      <p id="vacio" class="aviso" hidden>
        Ahora mismo no hay vehículos publicados. Llámanos y te decimos qué tenemos.
      </p>
      <p id="error" class="aviso aviso--error" hidden>
        No hemos podido cargar la flota. Escríbenos por WhatsApp y te la contamos.
      </p>
    </div>
  </section>

  <!-- ---- Requisitos ----------------------------------------------------- -->
  <section class="seccion" id="requisitos">
    <div class="contenedor requisitos">
      <div>
        <p class="overline">Requisitos</p>
        <h2>Lo que necesitas para alquilar</h2>
        <ul class="lista-check">
          <li>Permiso de conducir en vigor</li>
          <li>Edad mínima 21 años</li>
          <li>DNI o pasaporte del conductor</li>
          <li>Los conductores que vayan a turnarse, nombrados en el contrato</li>
        </ul>
      </div>

      <aside class="card oficina">
        <p class="overline">Oficina</p>
        <h3>{EMPRESA.oficinaCalle}</h3>
        <p class="oficina__nota">
          {EMPRESA.oficinaCiudad}. Si te viene mejor, llevamos el coche a donde acordemos.
        </p>
        <div class="oficina__acciones">
          <a class="btn btn--soft" href={`https://wa.me/${EMPRESA.telefonoWhatsapp}`} rel="noopener">
            {EMPRESA.telefono}
          </a>
          <a class="btn btn--ghost" href={`mailto:${EMPRESA.correo}`}>Escribir un email</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { flota } from '../lib/api';
  import { tarjetaCoche } from '../lib/tarjeta';

  const lista = document.getElementById('lista')!;
  const cargando = document.getElementById('cargando')!;
  const vacio = document.getElementById('vacio')!;
  const error = document.getElementById('error')!;

  flota()
    .then(({ vehicles }) => {
      cargando.hidden = true;
      if (!vehicles.length) {
        vacio.hidden = false;
        return;
      }
      // En la portada solo los tres primeros: el resto, en /flota.
      lista.innerHTML = vehicles.slice(0, 3).map((v) => tarjetaCoche(v)).join('');
      lista.hidden = false;
    })
    .catch(() => {
      cargando.hidden = true;
      error.hidden = false;
    });
</script>

<style>
  .hero {
    background: var(--velto-black);
    color: var(--velto-white);
    padding-top: var(--sp-20);
    /* El buscador cuelga por debajo del bloque negro. */
    padding-bottom: 0;
  }

  .hero__titular {
    font-size: var(--fs-display);
    font-weight: var(--fw-bold);
    max-width: 16ch;
    margin-bottom: var(--sp-6);
  }

  .hero__entrada {
    font-size: var(--fs-lead);
    color: var(--gray-300);
    max-width: 46ch;
    margin-bottom: var(--sp-16);
  }

  /*
   * El buscador monta sobre el corte: mitad sobre el negro, mitad fuera. Es lo
   * que hace que la portada se lea como una sola pieza.
   */
  .buscador {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: 1fr;
    align-items: end;
    padding: var(--sp-6);
    background: var(--gray-900);
    border: var(--bw) solid var(--gray-800);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-4);
    transform: translateY(50%);
  }

  @media (min-width: 720px) {
    .buscador { grid-template-columns: 1fr 1fr auto; }
  }

  .buscador__campo { display: grid; gap: var(--sp-2); min-width: 0; }

  .buscador__campo label {
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--gray-400);
  }

  .buscador input {
    min-height: var(--control-h);
    padding: 0 var(--sp-4);
    font-family: var(--font-num);
    color: var(--velto-white);
    background: var(--velto-black);
    border: var(--bw) solid var(--gray-800);
    border-radius: var(--r-md);
    /*
     * ⚠️ El calendario de un `input[type=date]` lo pinta el sistema y ningún
     * CSS lo alcanza: lo único que lo hace legible sobre fondo oscuro es
     * `color-scheme`. Es la misma lección del backoffice.
     */
    color-scheme: dark;
  }

  .buscador__btn { min-height: var(--control-h); }

  /* El hueco que deja el buscador al montar sobre el corte. */
  .promesas-seccion { padding-top: calc(var(--section-y) + 60px); }

  .promesa { padding: var(--sp-6); }
  .promesa__titulo { font-size: var(--fs-h4); margin-bottom: var(--sp-3); }
  .promesa__texto { color: var(--text-2); font-size: var(--fs-small); }

  .titulo-fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-6);
    flex-wrap: wrap;
    margin-bottom: var(--sp-8);
  }

  .requisitos {
    display: grid;
    gap: var(--sp-10);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .requisitos { grid-template-columns: 1.1fr 1fr; align-items: start; }
  }

  .lista-check { list-style: none; margin: var(--sp-6) 0 0; padding: 0; display: grid; gap: var(--sp-4); }

  .lista-check li {
    position: relative;
    padding-left: var(--sp-8);
    color: var(--text-2);
  }

  .lista-check li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 14px;
    height: 8px;
    border-left: 2px solid var(--brand);
    border-bottom: 2px solid var(--brand);
    transform: rotate(-45deg);
  }

  .oficina { padding: var(--sp-8); }
  .oficina h3 { margin: var(--sp-3) 0; }
  .oficina__nota { color: var(--text-2); font-size: var(--fs-small); margin-bottom: var(--sp-6); }
  .oficina__acciones { display: flex; gap: var(--sp-3); flex-wrap: wrap; }
</style>
