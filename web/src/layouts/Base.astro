    <script is:inline>
      document.getElementById('tema')?.addEventListener('click', function () {
        var d = document.documentElement;
        var nuevo = d.dataset.theme === 'dark' ? 'light' : 'dark';
        d.dataset.theme = nuevo;
        try { localStorage.setItem('velto-tema', nuevo); } catch (e) { /* modo privado */ }
      });

      /*
       * El menú plegable del móvil.
       *
       * ⚠️ **El estado vive en `aria-expanded`, no en una variable aparte.**
       * Son el mismo hecho: con dos, el día que una se quede sin actualizar el
       * botón diría una cosa a la vista y otra a un lector de pantalla — y el
       * que se queda viejo es siempre el que no se mira. Es la misma decisión
       * que el interruptor de vista de la página de resultados.
       */
      (function () {
        var boton = document.getElementById('cab-menu');
        var menu = document.getElementById('menu-principal');
        if (!boton || !menu) return;

        function poner(abierto) {
          boton.setAttribute('aria-expanded', String(abierto));
          boton.setAttribute('aria-label', abierto ? 'Cerrar el menú' : 'Abrir el menú');
          menu.classList.toggle('esta-abierto', abierto);
        }

        boton.addEventListener('click', function () {
          poner(boton.getAttribute('aria-expanded') !== 'true');
        });

        /*
         * ⚠️ **Se cierra al tocar fuera y con Escape.** Un panel que solo se
         * cierra con su propio botón obliga a volver a buscarlo, y en un móvil
         * tapa media pantalla. Es lo mismo que el backoffice tuvo que
         * aprender con su menú «Más», que se quedaba abierto encima de la
         * pantalla siguiente.
         */
        document.addEventListener('click', function (e) {
          if (boton.getAttribute('aria-expanded') !== 'true') return;
          if (boton.contains(e.target) || menu.contains(e.target)) return;
          poner(false);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') poner(false);
        });

        /*
         * ⚠️ **Y al pasar a escritorio.** Cruzando los 1040 px el CSS vuelve a
         * enseñar el menú entero y esconde el botón: sin esto, el `aria-expanded`
         * se quedaría en `true` para siempre, y al volver a móvil el menú
         * saldría abierto sin que nadie lo hubiera pedido.
         */
        var ancho = matchMedia('(min-width: 1040px)');
        ancho.addEventListener('change', function (e) {
          if (e.matches) poner(false);
        });
      })();
    </script>

    <style is:global>
      .cab {
