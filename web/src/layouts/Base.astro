       *
       * La de marca lleva 1,4fr porque dentro van la dirección y el correo, que
       * son líneas largas; las otras cuatro son listas de enlaces cortos.
       */
      @media (min-width: 1000px) {
        .pie__rejilla {
          grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr));
          column-gap: var(--sp-8);
        }
        /* ⚠️ Y fuera el `max-width`, o la columna sale más estrecha que su
           carril y el hueco de al lado parece un error. */
        .pie__marca { max-width: none; }
      }

      .pie__marca { max-width: 34ch; }
      /*
       * ⚠️ **El mismo ancho que la cabecera, y por el mismo camino.** El logo
       * del pie medía 120 px contra los 185 de arriba: en una página que se
       * recorre de un tirón, la marca se encogía a la mitad al llegar abajo.
       * Solo el ancho —la altura va `auto`— por lo mismo que arriba: tocando
       * los dos a mano se pierde la proporción del SVG.
       */
      .pie__marca img { margin-bottom: var(--sp-5); }
      .pie__marca p { color: var(--gray-400); margin-bottom: var(--sp-5); }

      .pie__datos { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
      .pie__datos li { display: flex; gap: var(--sp-3); align-items: flex-start; }
      .pie__datos svg { flex: none; margin-top: 3px; color: var(--gray-500); }

      .pie .overline { margin-bottom: var(--sp-4); display: block; color: var(--teal-300); }

      .pie__enlaces { list-style: none; margin: 0 0 var(--sp-6); padding: 0; display: grid; gap: var(--sp-3); }
      .pie a { color: var(--gray-300); }
      .pie a:hover { color: var(--velto-white); }

      /* `.pie__legal` se fue con el bloque del NIF: ahora eso vive en
         `/aviso-legal`, que declara lo suyo. */

      .pie__cierre {
        margin-top: var(--sp-12);
        padding-top: var(--sp-6);
        border-top: var(--bw) solid var(--gray-800);
        display: flex;
        justify-content: space-between;
        gap: var(--sp-4);
        flex-wrap: wrap;
        color: var(--gray-500);
        font-size: var(--fs-caption);
      }
    </style>
  </body>
</html>
