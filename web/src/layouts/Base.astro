---
import '../styles/global.css';
import { EMPRESA, SITIO, ES_SITIO_REAL } from '../lib/empresa';

interface Props {
  titulo: string;
  descripcion: string;
  /**
   * La ruta de ESTA página, para componer su canónica. `''` es la portada.
   *
   * ⚠️ **Obligatoria y sin valor por defecto, y eso es el arreglo de un fallo
   * real.** Era `ruta?: string` con defecto `''`, así que la página que se
   * olvidara de pasarla se publicaba **declarando ser la portada**. Se
   * olvidaban dos: la ficha de coche y el 404 — medido en el build,
   * `dist/coche.html` traía `<link rel="canonical" href="https://veltomobility.com">`.
   * O sea que las fichas de coche, que son el contenido que de verdad se
   * buscaría, le decían a Google que todas son copias de la portada: ninguna
   * podría posicionar nunca, y encima se declaraban duplicadas entre sí.
   *
   * No se veía porque la web de desarrollo va con `noindex` y producción aún no
   * existe: habría salido a la luz el día de publicar y no antes.
   *
   * `null` significa **esta página no declara canónica**, que es distinto de
   * «es la portada» y es lo que corresponde a una página cuyo path no se conoce
   * al compilar. Sin defecto, el compilador obliga a contestar una de las dos.
   */
  ruta: string | null;
  /**
   * Qué datos adelantar desde el `<head>`, si esta página pide alguno.
   *
   * ⚠️ **Lo que ahorra es medio segundo en toda visita**, y no por ir más
   * rápido: por dejar de esperar. La petición era el cuarto eslabón de una
   * cadena en serie —HTML, módulo, `api.js`, `fetch`— y no arrancaba hasta los
   * 812 ms, porque el navegador no puede saber que el siguiente eslabón existe
   * hasta terminar el anterior. Desde el `<head>` arranca a los ~240 ms.
   *
   * `'flota'` para las páginas que enseñan la lista; `'coche'` para la ficha,
   * que saca el id del path.
   */
  precarga?: 'flota' | 'coche';
}

const { titulo, descripcion, ruta, precarga } = Astro.props;

/**
 * El script que adelanta la petición de datos, como TEXTO.
 *
 * ⚠️ **Va por `set:html` y no escrito dentro del `<script>`, y eso es el
 * arreglo de un fallo que no daba ningún error.** Escrito como
 * `<script is:inline>{\`…\`}</script>`, Astro emite las llaves y el backtick
 * **literales** en el HTML, así que al navegador le llega un bloque con una
 * cadena suelta dentro: sintaxis perfectamente válida, sin error en consola, y
 * que no hace nada. El script viajaba en la página, se desplegó, y
 * `window.__veltoFleet` no existía — solo se vio midiendo si la petición
 * arrancaba antes, que es para lo que existe.
 *
 * Es el patrón de fallo de esta casa en una línea: código escrito y nunca
 * ejecutado.
 *
 * ⚠️ **Y la petición tiene que ser IDÉNTICA a la de `pedir()` en `api.ts`**
 * —misma ruta y la misma cabecera `Accept`—, o el navegador no la reutiliza y
 * se harían DOS. Con el arranque en frío de las functions, eso es pagarlo dos
 * veces en vez de ninguna.
 *
 * No se maneja el error a propósito: si falla, la promesa queda rechazada y
 * `adelantada()` reintenta por el camino normal, que sí sabe distinguir «roto»
 * de «vacío» y decírselo al visitante.
 */
const CABECERA_JSON = `{ headers: { Accept: 'application/json' } }`;
const A_JSON = `function (r) { if (!r.ok) throw new Error('error'); return r.json(); }`;

const adelanto =
  precarga === 'flota'
    ? `window.__veltoFleet=fetch('/api/fleet',${CABECERA_JSON}).then(${A_JSON});`
    : precarga === 'coche'
      ? `(function(){var i=decodeURIComponent(location.pathname.split('/').filter(Boolean).pop()||'');` +
        `if(!i)return;window['__veltoVehicle:'+i]=fetch('/api/vehicle?id='+encodeURIComponent(i),${CABECERA_JSON}).then(${A_JSON});})();`
      : null;
const canonica = ruta === null ? null : SITIO + ruta;
const anio = new Date().getFullYear();
const tel = EMPRESA.telefono.replace(/\s/g, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />

    {/*
      ⚠️ **Las fotos viven en OTRO origen, y el saludo se paga dentro del camino
      crítico.** Salen de `firebasestorage.googleapis.com`, así que la primera no
      puede empezar a bajar hasta hacer DNS + TCP + TLS contra un servidor con el
      que el navegador no ha hablado todavía — y eso cae en el peor momento: a
      los ~1.150 ms, justo cuando la API acaba de contestar y las cuatro fotos
      quieren salir a la vez.

      Con `preconnect` ese saludo se hace **en paralelo** con el resto de la
      carga, mucho antes de que se sepa qué fotos hay. `crossorigin` no es
      opcional: sin él el navegador abre una conexión anónima distinta de la que
      luego usará para las imágenes, y el saludo se paga igual.
    */}
    <link rel="preconnect" href="https://firebasestorage.googleapis.com" crossorigin />

    {adelanto && <script is:inline set:html={adelanto} />}

    {/*
      ⚠️ La canónica es lo que impide que los DOS dominios compitan entre sí.
      `veltorent.com` sirve el mismo sitio; sin esto, Google reparte el
      posicionamiento en vez de sumarlo y puede acabar enseñando el que no
      queremos.
    */}
    {canonica && <link rel="canonical" href={canonica} />}

    {
      /*
       * ⚠️ **El sitio de desarrollo NO se indexa, y la canónica de arriba no
       * basta para conseguirlo.** `velto-web-dev.web.app` se servía con
       * `Allow: /` y con esa canónica apuntando a producción: o sea, un
       * duplicado completo del escaparate ofrecido a Google. Una canónica es
       * una **pista**, no una orden —Google puede ignorarla y elegir la copia
       * que le parezca—, y encima hasta que el dominio de producción sirva de
       * verdad, el único que existe es este. Eso lo deja compitiendo consigo
       * mismo, que es justo lo que se quería evitar.
       *
       * La marca es del rastreador, no del navegador: `noindex` saca la página
       * del índice y `nofollow` evita que los enlaces internos arrastren a las
       * demás.
       */
      !ES_SITIO_REAL && <meta name="robots" content="noindex, nofollow" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Velto" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta name="theme-color" content="#20A48F" />

    {/*
      ⚠️ **El tema se aplica ANTES de pintar, y por eso va aquí en crudo.** Con
      el script al final, una recarga en tema oscuro enseña un fogonazo blanco
      antes de corregirse — es exactamente el parpadeo que el backoffice ya tuvo
      que resolver con su pantalla de arranque.
    */}
    <script is:inline>
      (function () {
        try {
          var g = localStorage.getItem('velto-tema');
          var oscuro = g ? g === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>

  <body>
    <header class="cab">
      <div class="contenedor cab__fila">
        {/*
          ⚠️ **Un 40% más grande: 132×34 → 185×48.** Lo pidió Dorel porque la
          marca no resaltaba. Los atributos `width`/`height` no son decorativos:
          reservan el hueco antes de que el SVG cargue, y sin ellos la cabecera
          pega un salto al pintar.
        */}
        <a class="cab__logo" href="/" aria-label="Velto, inicio">
          <img src="/brand/logo-on-light.svg" alt="Velto" class="cab__logo--claro" width="185" height="48" />
          <img src="/brand/logo-on-dark.svg" alt="Velto" class="cab__logo--oscuro" width="185" height="48" />
        </a>

        <nav class="cab__nav" aria-label="Principal">
          <a href="/flota">Flota</a>
          <a href="/entrega-a-domicilio">Entrega a domicilio</a>
          <a href="/condiciones">Condiciones</a>
          <a href="/contacto">Contacto</a>
        </nav>

        <div class="cab__acciones">
          <a class="cab__tel" href={`tel:${tel}`}>
            {/*
              ⚠️ **Esto es el icono DEL KIT, y antes no lo era.** El kit define
              un `Icon` canónico —caja 24, `fill: none`, trazo `1.75`, remates y
              uniones redondeados— y su cabecera lo pide a `18`. Aquí había 16 px
              con trazo `2`, sin `stroke-linejoin`, y **un path propio**: un
              recorte del auricular, no el auricular. A ese grosor y ese tamaño
              se empastaba y quedaba como una mancha al lado de un número que sí
              se lee.

              El path es el del kit (`phone`), completo.
            */}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>{EMPRESA.telefono}</span>
          </a>

          {/*
            ⚠️ **Los DOS iconos van en el HTML y los cambia el CSS.** Pintar uno
            y sustituirlo con JavaScript haría que en la primera pintura saliera
            el que no toca: el tema se resuelve en el `<head>` —antes de pintar,
            para que no haya fogonazo— pero el icono se decidiría al final. Un
            parpadeo de luna a sol en cada carga, justo lo que ese script evita.

            ⚠️ **Y el icono dice A QUÉ SE VA, no dónde se está.** En claro la
            luna —«ponlo oscuro»—, en oscuro el sol. Un botón dice lo que hace
            al pulsarlo.

            El tema ya arrancaba siguiendo al sistema (`prefers-color-scheme`);
            lo que faltaba era que el botón lo contara.
          */}
          <button id="tema" class="cab__tema" type="button" aria-label="Cambiar entre tema claro y oscuro">
            <svg class="cab__tema-luna" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
            <svg class="cab__tema-sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
          </button>

          {/*
            ⚠️ **Aquí había un botón «Reservar» y sobraba.** Llevaba a
            `/reservar`, que es el mismo buscador que está unos píxeles más abajo
            en la propia portada: un botón que lleva a donde ya estás. Lo señaló
            Dorel el 29 de septiembre de 2026.

            La página `/reservar` sigue existiendo y el menú no la enseña a
            propósito: es el destino del buscador, no un sitio al que se navega.
          */}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <div class="pie__rejilla">
          <div class="pie__marca">
            <img src="/brand/logo-on-dark.svg" alt="Velto" width="120" height="31" />
            {/*
              ⚠️ **Aquí ponía «seguro a todo riesgo», y va en TODAS las
              páginas.** La cláusula 13 dice que el coche lleva la
              responsabilidad civil obligatoria y que el todo riesgo «sólo será
              aplicable si ha sido expresamente contratado y abonado por el
              ARRENDATARIO». O sea que el pie de cada página prometía una
              cobertura que el contrato niega — y sobrevivió al repaso del 28 de
              septiembre de 2026, que solo miró la portada.

              La lección es la de siempre en esta casa: al cambiar una
              afirmación, **búscala en todo el sitio**, no en la pantalla desde
              la que te la señalaron.
            */}
            <p>
              Alquiler de coches en Arganda del Rey con el precio cerrado al
              reservar y entrega a domicilio.
            </p>
            <ul class="pie__datos">
              <li>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>{EMPRESA.oficina}</span>
              </li>
              <li>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 10.5c.5 2 2 3.5 4.5 4.5l1-1.2a.8.8 0 0 1 .9-.2l1.8.8a1 1 0 0 1 .6.9v1.8a1 1 0 0 1-1.1 1A13 13 0 0 1 5 7.3 1 1 0 0 1 6 6.2h1.8a1 1 0 0 1 .9.6l.8 1.8a.8.8 0 0 1-.2.9Z"/></svg>
                <a href={`https://wa.me/${EMPRESA.telefonoWhatsapp}`} rel="noopener">{EMPRESA.telefono} · WhatsApp</a>
              </li>
              <li>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                <a href={`mailto:${EMPRESA.correo}`}>{EMPRESA.correo}</a>
              </li>
            </ul>
          </div>

          <div>
            <p class="overline">Alquiler</p>
            <ul class="pie__enlaces">
              <li><a href="/flota">Flota</a></li>
              <li><a href="/entrega-a-domicilio">Entrega a domicilio</a></li>
              <li><a href="/reservar">Consultar fechas</a></li>
            </ul>
          </div>

          <div>
            <p class="overline">Ayuda</p>
            <ul class="pie__enlaces">
              <li><a href="/condiciones#requisitos">Requisitos para alquilar</a></li>
              <li><a href="/condiciones#cancelar">Modificar o cancelar</a></li>
              <li><a href="/condiciones#averia">Qué hacer en caso de avería</a></li>
              <li><a href="/contacto">Contacto</a></li>
            </ul>
          </div>

          <div>
            <p class="overline">Legal</p>
            <ul class="pie__enlaces">
              <li><a href="/condiciones">Condiciones de alquiler</a></li>
            </ul>
            {/*
              ⚠️ El ÚNICO sitio donde aparece la razón social, y va junto al
              NIF: es donde la empresa comparece como persona jurídica. En todo
              lo demás, la marca. Y `razonSocial` acaba en punto, así que la
              frase no lleva otro detrás.
            */}
            <p class="pie__legal">
              {EMPRESA.razonSocial}<br />
              NIF {EMPRESA.nif}<br />
              {EMPRESA.domicilioSocial}
            </p>
          </div>
        </div>

        <div class="pie__cierre">
          <span>© {anio} Velto Mobility · veltorent.com · veltomobility.com</span>
          <span>Precios en euros, IVA incluido</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('tema')?.addEventListener('click', function () {
        var d = document.documentElement;
        var nuevo = d.dataset.theme === 'dark' ? 'light' : 'dark';
        d.dataset.theme = nuevo;
        try { localStorage.setItem('velto-tema', nuevo); } catch (e) { /* modo privado */ }
      });
    </script>

    <style is:global>
      .cab {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--bg);
        border-bottom: var(--bw) solid var(--border);
      }

      .cab__fila {
        display: flex;
        align-items: center;
        gap: var(--sp-8);
        min-height: 72px;
      }

      .cab__logo { flex: none; }
      /* Un logo por tema: el isotipo va en negativo sobre fondo oscuro. */
      [data-theme='light'] .cab__logo--oscuro,
      [data-theme='dark'] .cab__logo--claro { display: none; }

      .cab__nav {
        display: flex;
        gap: var(--sp-6);
        margin-right: auto;
      }

      /*
       * El subrayado del menú: grueso, cortado en oblicuo y animado.
       *
       * ⚠️ **No puede ser un `border-bottom`, que es lo que era.** Un borde no
       * se inclina ni crece: o está o no está, y aparecía de golpe con los
       * extremos rectos. Con un pseudoelemento se pueden hacer las tres cosas
       * que pidió Dorel.
       *
       * ⚠️ **Y el corte oblicuo no es un adorno: es `--skew`, la inclinación
       * real de la «V» y la «E» del logotipo.** El kit ya subraya así su enlace
       * activo —3 px, `var(--brand)`, `skewX(var(--skew))`—, o sea que esto no
       * se inventa nada: adopta lo que el kit ya hacía y que esta web no había
       * copiado. Aquí va a 4 px porque Dorel pidió que resaltara, y porque lo
       * del kit marca «dónde estoy» mientras esto marca además el hover.
       *
       * ⚠️ **Crece con `scaleX`, no con `width`.** El ancho lo anima el hilo
       * principal, recalculando la disposición de la cabecera en cada
       * fotograma; una transformación la resuelve el compositor. Es la
       * diferencia entre un subrayado que se desliza y uno que se arrastra.
       *
       * ⚠️ **Y el skew y la escala van en la MISMA declaración.** `transform`
       * es una sola propiedad: escritos en dos reglas, la segunda borra la
       * primera y el subrayado sale recto sin que nada falle.
       */
      .cab__nav a {
        position: relative;
        color: var(--text);
        font-size: var(--fs-small);
        font-weight: var(--fw-medium);
        padding: var(--sp-2) 0;
      }

      .cab__nav a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 4px;
        background: var(--brand);
        transform: skewX(var(--skew)) scaleX(0);
        /* Nace del centro: es donde está el ojo al pasar por encima. */
        transform-origin: center;
        transition: transform var(--t-fast) var(--ease);
      }

      .cab__nav a:hover,
      .cab__nav a[aria-current='page'] { color: var(--brand-text); text-decoration: none; }

      .cab__nav a:hover::after,
      .cab__nav a[aria-current='page']::after { transform: skewX(var(--skew)) scaleX(1); }

      /*
       * ⚠️ **Quien pide menos movimiento lo tiene.** El subrayado sigue
       * apareciendo —es la señal de dónde está el puntero, y quitarla dejaría
       * el menú sin respuesta— pero llega sin recorrido.
       */
      @media (prefers-reduced-motion: reduce) {
        .cab__nav a::after { transition: none; }
      }

      .cab__acciones { display: flex; align-items: center; gap: var(--sp-4); }

      .cab__tel {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        color: var(--text);
        font-weight: var(--fw-medium);
        font-size: var(--fs-small);
      }
      .cab__tel span { font-family: var(--font-num); }

      .cab__tema {
        display: grid;
        place-items: center;
        width: var(--touch);
        height: var(--touch);
        background: transparent;
        border: none;
        border-radius: var(--r-pill);
        color: var(--text-2);
        cursor: pointer;
      }
      .cab__tema:hover { color: var(--brand-text); }

      /*
       * El icono dice a dónde se VA, no dónde se está: en claro la luna, en
       * oscuro el sol. Lo decide el CSS con el mismo `data-theme` que el
       * script del `<head>` ya dejó puesto antes de la primera pintura, así
       * que no hay parpadeo.
       */
      [data-theme='light'] .cab__tema-sol,
      [data-theme='dark'] .cab__tema-luna { display: none; }

      /*
       * ⚠️ En móvil la navegación se RECOLOCA, no se esconde tras un botón.
       * «Flota» y «Contacto» son la mitad de las visitas que llegan con el
       * pulgar, y lo que no se ve no se pulsa.
       *
       * ⚠️ **Y eso exige que la cabecera quepa en DOS filas: marca + acciones
       * arriba, navegación debajo.** Salía en tres y midiendo 191 px —casi un
       * cuarto de la pantalla de un móvil antes de empezar a leer—, por dos
       * motivos distintos que se medieron el 25 de septiembre de 2026 en un
       * ancho de 375 px:
       *
       * 1. **Los enlaces partían en dos líneas.** `overflow-x: auto` pone una
       *    tira deslizable, pero sin `white-space: nowrap` el navegador
       *    prefiere partir la palabra antes que desbordar: «Entrega a
       *    domicilio» medía 73 px —el ancho de «Entrega a»— y el nav ocupaba
       *    60 px de alto. Con `nowrap` los cuatro suman 366 px, no caben en
       *    320, y **entonces sí** aparece el deslizamiento que se pretendía.
       * 2. **La marca y las acciones no cabían juntas por 19 px**: 132 + 12 +
       *    203 = 347 para 328 de contenido. Se recuperan apretando el hueco
       *    entre acciones y el relleno del botón, **sin tocar la altura**: los
       *    44 px del botón de tema y los 48 del de reservar son zona táctil y
       *    ahí no se recorta.
       */
      @media (max-width: 900px) {
        .cab__fila { flex-wrap: wrap; gap: var(--sp-3); padding-block: var(--sp-3); }
        .cab__nav { order: 3; width: 100%; margin: 0; overflow-x: auto; gap: var(--sp-5); }
        /* Sin esto la tira deslizable no existe: los enlaces se parten. */
        .cab__nav a { white-space: nowrap; flex: none; }
        /* La barra de deslizamiento sobra: es una tira de cuatro enlaces. */
        .cab__nav { scrollbar-width: none; }
        .cab__nav::-webkit-scrollbar { display: none; }

        .cab__acciones { margin-left: auto; gap: var(--sp-2); }
        .cab__acciones .btn { padding-inline: var(--sp-4); }

        /*
         * ⚠️ **Escondiendo el número, lo único que queda pulsable es el SVG de
         * 16 px** — y eso es el botón de LLAMAR, que en este negocio es la
         * acción principal: la portada promete «Alguien responde». El botón de
         * tema que tiene al lado sí mide `--touch` (44 px), así que en un móvil
         * cambiar el tema era tres veces más fácil que llamar.
         *
         * El número se sigue escondiendo —no cabe— pero el área no: se le da la
         * misma caja de 44 px que a su vecino. Es la misma regla que el aspa del
         * backoffice, donde lo que crece para el dedo es dónde se acierta y no
         * el dibujo.
         */
        .cab__tel span { display: none; }
        .cab__tel {
          display: grid;
          place-items: center;
          width: var(--touch);
          height: var(--touch);
        }
      }

      /* ---- Pie ---- */

      .pie {
        background: var(--velto-black);
        color: var(--gray-300);
        padding-block: var(--sp-16) var(--sp-8);
        font-size: var(--fs-small);
      }

      .pie__rejilla {
        display: grid;
        gap: var(--sp-10);
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
      }

      .pie__marca { grid-column: span 1; max-width: 34ch; }
      @media (min-width: 900px) { .pie__marca { grid-column: span 1; } }
      .pie__marca img { margin-bottom: var(--sp-5); }
      .pie__marca p { color: var(--gray-400); margin-bottom: var(--sp-5); }

      .pie__datos { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
      .pie__datos li { display: flex; gap: var(--sp-3); align-items: flex-start; }
      .pie__datos svg { flex: none; margin-top: 3px; color: var(--gray-500); }

      .pie .overline { margin-bottom: var(--sp-4); display: block; color: var(--teal-300); }

      .pie__enlaces { list-style: none; margin: 0 0 var(--sp-6); padding: 0; display: grid; gap: var(--sp-3); }
      .pie a { color: var(--gray-300); }
      .pie a:hover { color: var(--velto-white); }

      .pie__legal { color: var(--gray-500); font-size: var(--fs-caption); line-height: var(--lh-relaxed); }

      .pie__cierre {
        margin-top: var(--sp-12);
        padding-top: var(--sp-6);
        border-top: var(--bw) solid var(--gray-800);
        display: flex;
        justify-content: space-between;
        gap: var(--sp-4);
        flex-wrap: wrap;
        color: var(--gray-500);
        font-size: var(--fs-caption);
      }
    </style>
  </body>
</html>
